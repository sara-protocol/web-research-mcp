# Required: generate a long random token, e.g. openssl rand -hex 32
MCP_BEARER_TOKEN=replace_with_a_long_random_secret

# Required for web_search: create a Brave Search API key and set it here.
BRAVE_SEARCH_API_KEY=replace_with_brave_search_api_key

# Bind inside Docker; leave as 0.0.0.0 for container networking.
HOST=0.0.0.0
PORT=8787

# ChatGPT's custom MCP connection currently offers OAuth or no-auth, not a generic bearer-token setting.
# Enable this only when you want to connect ChatGPT using the read-only, rate-limited /public/mcp endpoint.
PUBLIC_MCP_ENABLED=false
PUBLIC_PER_MINUTE_LIMIT=12
PUBLIC_DAILY_SEARCH_LIMIT=100

# Set true only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
